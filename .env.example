# Server
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN="http://localhost:5173"
# Public base URL of THIS backend, used to build absolute URLs for uploaded
# images (e.g. https://sutera-api.onrender.com). Leave blank for local dev —
# it's inferred from the request automatically.
PUBLIC_URL=

# Database — SQLite by default (zero setup). Swap to Postgres for production
# by changing `provider` in prisma/schema.prisma to "postgresql" and setting
# a Postgres connection string here.
DATABASE_URL="file:./dev.db"

# Admin auth — signs admin session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string"

# Razorpay TEST mode credentials — https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
